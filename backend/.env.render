# ═══════════════════════════════════════════════════════════════════════════════
# RENDER DEPLOYMENT - ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this to Render dashboard (Settings → Environment) and update values

# ─────────────────────────────────────────────────────────────────────────────
# Django Core
# ─────────────────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=your-secret-key-generate-strong-one-here-change-this-in-render

# ─────────────────────────────────────────────────────────────────────────────
# Allowed Hosts & CORS
# ─────────────────────────────────────────────────────────────────────────────
ALLOWED_HOSTS=rnc-backend.onrender.com,localhost,127.0.0.1

# After Vercel deployment, update this with your frontend URL
CORS_ALLOWED_ORIGINS=https://rnc-frontend.vercel.app,http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL Database (Render Internal)
# ─────────────────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Get this from Render PostgreSQL service Info tab
DATABASE_URL=postgresql://rnc_user:vwQXxA3CRXufHPq57sXBAQDPbbOSLtRy@dpg-d87p0dps16ns73f28i7g-a/rnc_db_2tix

# ─────────────────────────────────────────────────────────────────────────────
# Groq API (Optional - for AI features)
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-if-using-ai-features